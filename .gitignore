# Test outputs and runs
test_output/
*_redline_*/
ASB_*/
backup_*/

# Documents
*.docx
*.doc
*.pdf
# Allow docx files in named test upload dirs
!app/data/uploads/test-*/*.docx
# Allow docx files in testdocs (the test document source files)
!testdocs/*.docx

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vscode/
.idea/

# API keys
api.txt
anthropic_api.txt
*.key
.env

# Working directories
output/
Other Files/

# Session and upload data (exclude live session data but allow named test sessions)
app/data/sessions/
!app/data/sessions/test-*.json
app/data/uploads/
!app/data/uploads/test-*/
!app/data/uploads/test-*/**

# Logs
*.log

# Node.js
node_modules/

# Misc
nul

# OS
.DS_Store
Thumbs.db
.claude/settings.local.json

# Agent config symlinks (machine-specific)
.agents
.claude/CLAUDE.md
.claude/commands
.claude/hooks
.claude/skills
.codex/
.gemini/
test documents/.agents/
test documents/.claude/
test documents/.codex/
test documents/.gemini/
testdocs/.agents/
testdocs/.claude/
testdocs/.codex/
testdocs/.gemini/
testdocs/.venv/

gha-creds-*.json
